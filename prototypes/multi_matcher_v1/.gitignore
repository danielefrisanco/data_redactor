# Build artifacts — the Makefile regenerates all of these. Only source
# (*.c, *.h, *.rb, Makefile, this file) is tracked.
#
# The artifact globs (matcher*, bench_*, smoke*) would also match source like
# matcher19.c, so the !*.c/!*.h/!*.rb negations below re-include source.

*.so
matcher*
bench_*
smoke*

!*.c
!*.h
!*.rb
!Makefile
!.gitignore

# Generated header — re-ignored after the !*.h negation above.
patterns_generated.h
